# =====================================================================
# Rust
# =====================================================================
/target

# Cargo.lock IS committed (binary application — reproducible builds).

# =====================================================================
# Secrets & local config
# =====================================================================
.env
.env.*
!.env.example

# Mosquitto password file — WAJIB di-generate per environment via
# `mosquitto_passwd` (lihat AGENT.md → "MQTT auth setup"). Hash-nya
# spesifik untuk password operator, jadi tidak boleh ke-commit.
mosquitto/config/passwd

# =====================================================================
# Docker & persistent data
# =====================================================================
mosquitto/data/
mosquitto/log/*.log
!mosquitto/log/.gitkeep

