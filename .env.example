# =====================================================================
# ALTIVEX Backend — Environment template
# =====================================================================
# 1. Copy file ini ke `.env` (di folder `altivex_backend/` yang sama).
# 2. Isi nilai REPLACE_ME dengan secret produksi.
# 3. JANGAN commit `.env` (sudah di-ignore oleh `.gitignore`).
# 4. Untuk generate token kuat: `openssl rand -hex 32`.
# =====================================================================

# --- DATABASE ----------------------------------------------------------
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Saat di-deploy via docker-compose, host = "postgres" (nama service).
DATABASE_URL=postgres://REPLACE_ME_USER:REPLACE_ME_PASSWORD@postgres:5432/altivex_db

# --- POSTGRES (dipakai oleh container `postgres` di compose) -----------
POSTGRES_USER=REPLACE_ME_USER
POSTGRES_PASSWORD=REPLACE_ME_PASSWORD
POSTGRES_DB=altivex_db

# --- MQTT --------------------------------------------------------------
# Saat di-deploy via docker-compose, host = "mosquitto".
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# Mosquitto sekarang `allow_anonymous false` (Bug B2 / Task 3.7).
# Username + password DI SINI harus match entry di
# `mosquitto/config/passwd`. Generate passwd:
#   docker run --rm -v "$PWD/mosquitto/config":/work -w /work \
#       eclipse-mosquitto:latest mosquitto_passwd -b -c passwd \
#       <username> <password>
MQTT_USERNAME=REPLACE_ME_MQTT_USER
MQTT_PASSWORD=REPLACE_ME_MQTT_PASSWORD

# --- API AUTH ----------------------------------------------------------
# Bearer token untuk endpoint mutating (Bug B3 / Task 3.8). Pakai string
# acak panjang (≥ 32 byte). Frontend akan menyimpan token ini di
# localStorage SECARA OTOMATIS setelah login sukses (lihat
# BASECAMP_USERNAME / BASECAMP_PASSWORD di bawah).
API_AUTH_TOKEN=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# --- LOGIN BASECAMP ----------------------------------------------------
# Single-user login flow (UI #4 user feedback). Operator basecamp tidak
# lagi perlu paste token mentah ke `prompt()` browser — cukup login
# dengan username + password di halaman login.
#
# Backend `/api/login` memvalidasi credentials terhadap dua env ini
# secara constant-time. Sukses → return `API_AUTH_TOKEN` di body, yang
# disimpan frontend ke localStorage dan dipakai untuk Bearer auth.
#
# Pilih username yang mudah diingat operator. Password sebaiknya
# panjang & unik (BUKAN samakan dengan POSTGRES_PASSWORD / MQTT
# password). Generate: `openssl rand -base64 18`.
BASECAMP_USERNAME=admin
BASECAMP_PASSWORD=REPLACE_ME_STRONG_PASSWORD

# --- SERIAL ------------------------------------------------------------
# Linux/WSL: /dev/ttyUSB0. Windows host: COM3, COM4, dst.
# Failsafe-mode hanya aktif saat alat Heltec basecamp dicolok ke server;
# kalau tidak ada perangkat, biarkan default — reader akan retry tiap 5s
# tanpa crash.
SERIAL_PORT=/dev/ttyUSB0

# --- LOGGING (opsional) ------------------------------------------------
# Lihat https://docs.rs/env_logger untuk format. Default: `info`.
RUST_LOG=info
